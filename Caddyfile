# Caddyfile for camelAI with automatic TLS
# Replace camel.yourdomain.com with your actual domain

camel.yourdomain.com {
    # Reverse proxy to camelAI app
    reverse_proxy app:3001 {
        header_up Host {host}
        header_up X-Real-IP {remote_addr}
        header_up X-Forwarded-For {proxy_add_x_forwarded_for}
        header_up X-Forwarded-Proto {scheme}
    }

    # Enable compression
    encode gzip

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# Wildcard for deployed apps (optional)
*.camel.yourdomain.com {
    reverse_proxy app:3001 {
        header_up Host {host}
        header_up X-Real-IP {remote_addr}
        header_up X-Forwarded-For {proxy_add_x_forwarded_for}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }
}
